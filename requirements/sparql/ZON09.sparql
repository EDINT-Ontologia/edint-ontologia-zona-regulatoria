# Query: ZON09
# Question: ¿Qué vías o tramos de vía componen cada zona?

# --- Query 1 ---
PREFIX edintzone: <https://edint.es/def/zona-regulatoria#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?zona ?tipoZona ?via ?nombreVia
WHERE {
    ?zona rdf:type edintzone:RegulatedZone ;
          edintzone:hasRegulatedZoneType ?tipoZona .
    ?zona edintzone:composedOf ?via .
    OPTIONAL { ?via rdfs:label ?nombreVia . }
}
ORDER BY ?zona ?via

