<https://astrea.linkeddata.es/shapes#ea758cf93a4a6fcb568c859d464061d1> a sh:PropertyShape ;
    rdfs:label "Geometry representation in Well-Known Text format."@en,
        "as WKT"@en,
        "Representación de la geometría en formato Well-Known Text."@es,
        "como WKT"@es ;
    sh:datatype geo:wktLiteral ;
    sh:description "Geometry representation in Well-Known Text format."@en,
        "Representación de la geometría en formato Well-Known Text."@es ;
    sh:name "as WKT"@en,
        "como WKT"@es ;
    sh:nodeKind sh:Literal ;
    sh:path geo:asWKT .

<https://astrea.linkeddata.es/shapes#f2f8e642db1802bd2108b5033e293d3c> a sh:PropertyShape ;
    rdfs:label "Textual description of the zone's operating schedule (e.g., \"Monday to Friday from 07:00 to 20:00\")."@en,
        "schedule description"@en,
        "Descripción textual del horario de funcionamiento de la zona (ej. \"Lunes a Viernes de 07:00 a 20:00\")."@es,
        "horario descriptivo"@es ;
    sh:datatype xsd:string ;
    sh:description "Textual description of the zone's operating schedule (e.g., \"Monday to Friday from 07:00 to 20:00\")."@en,
        "Descripción textual del horario de funcionamiento de la zona (ej. \"Lunes a Viernes de 07:00 a 20:00\")."@es ;
    sh:name "schedule description"@en,
        "horario descriptivo"@es ;
    sh:nodeKind sh:Literal ;
    sh:path :scheduleDescription ;
    sh:pattern ".*" .

<https://astrea.linkeddata.es/shapes#f5f809079635252ac2c4c141692f59de> a sh:PropertyShape ;
    rdfs:label "Link to the official document (Bulletin, Ordinance) establishing the zone."@en,
        "legal reference"@en,
        "Enlace al documento oficial (Boletín, Ordenanza) que establece la creación de la zona."@es,
        "referencia legal"@es ;
    sh:datatype xsd:anyURI ;
    sh:description "Link to the official document (Bulletin, Ordinance) establishing the zone."@en,
        "Enlace al documento oficial (Boletín, Ordenanza) que establece la creación de la zona."@es ;
    sh:name "legal reference"@en,
        "referencia legal"@es ;
    sh:nodeKind sh:Literal ;
    sh:path :legalReference ;
    sh:pattern "^(([^:/?#]+):)?(//([^/?#]*))?([^?#]*)(\\?([^#]*))?(#(.*))?" .

<https://astrea.linkeddata.es/shapes#f7c592213ad33ec575dbc16899beae79> a sh:PropertyShape ;
    rdfs:label "Relates a regulated zone to the administrative municipality it belongs to."@en,
        "located in municipality"@en,
        "Relaciona una zona regulatoria con el municipio administrativo al que pertenece."@es,
        "ubicado en municipio"@es ;
    sh:class esadm:Municipio ;
    sh:description "Relates a regulated zone to the administrative municipality it belongs to."@en,
        "Relaciona una zona regulatoria con el municipio administrativo al que pertenece."@es ;
    sh:name "located in municipality"@en,
        "ubicado en municipio"@es ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path :locatedIn .

