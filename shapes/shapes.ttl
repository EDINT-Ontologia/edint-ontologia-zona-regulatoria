<https://astrea.linkeddata.es/shapes#12252540380e57d6e3965eab6d95b09b> a sh:PropertyShape ;
    rdfs:label "Relationship that allows defining a Regulated Zone via one or more streets or street segments from the Callejero vocabulary."@en,
