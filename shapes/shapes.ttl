    sh:description "Relationship that allows defining a Regulated Zone via one or more streets or street segments from the Callejero vocabulary."@en,
        "Relación que permite definir una Zona Regulatoria mediante una o más vías o tramos de vía del vocabulario Callejero."@es ;
    sh:name "composed of"@en,
        "compuesta por"@es ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path :composedOf .

<https://astrea.linkeddata.es/shapes#1cbfc6b5293434365909e4166df49c39> a sh:PropertyShape ;
    rdfs:label "Date when the zone regulation ceases to be effective."@en,
        "end date"@en,
        "Fecha en la que la regulación de la zona deja de ser efectiva (derogación o fin de periodo)."@es,
        "fecha de fin de vigor"@es ;
    sh:datatype xsd:date ;
    sh:description "Date when the zone regulation ceases to be effective."@en,
        "Fecha en la que la regulación de la zona deja de ser efectiva (derogación o fin de periodo)."@es ;
    sh:name "end date"@en,
        "fecha de fin de vigor"@es ;
    sh:nodeKind sh:Literal ;
    sh:path :endDate ;
    sh:pattern "-?([1-9][0-9]{3,}|0[0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?" .

<https://astrea.linkeddata.es/shapes#529574321a070f2a0aa0aac7112713d2> a sh:PropertyShape ;
    rdfs:label "Inverse property of 'locatedIn'. Links a municipality with the regulated zones it contains."@en,
        "has regulated zone"@en,
        "Propiedad inversa de 'ubicado'. Vincula un municipio con las zonas regulatorias que contiene."@es,
        "tiene zona regulatoria"@es ;
    sh:class :RegulatedZone ;
    sh:description "Inverse property of 'locatedIn'. Links a municipality with the regulated zones it contains."@en,
        "Propiedad inversa de 'ubicado'. Vincula un municipio con las zonas regulatorias que contiene."@es ;
    sh:name "has regulated zone"@en,
        "tiene zona regulatoria"@es ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path :hasRegulatedZone .

<https://astrea.linkeddata.es/shapes#5be7e90bac39cafb624fbfa0afb2351f> a sh:PropertyShape ;
    rdfs:label "Date from which the zone regulation becomes effective."@en,
        "entry into force date"@en,
        "Fecha a partir de la cual la regulación de la zona comienza a ser efectiva."@es,
        "fecha de entrada en vigor"@es ;
    sh:datatype xsd:date ;
    sh:description "Date from which the zone regulation becomes effective."@en,
        "Fecha a partir de la cual la regulación de la zona comienza a ser efectiva."@es ;
    sh:name "entry into force date"@en,
        "fecha de entrada en vigor"@es ;
    sh:nodeKind sh:Literal ;
    sh:path :startDate ;
    sh:pattern "-?([1-9][0-9]{3,}|0[0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?" .

