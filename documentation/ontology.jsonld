}, {
  "@id" : "http://vocab.linkeddata.es/datosabiertos/def/common/zone#",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-01-27"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "OEG-UPM"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "es",
    "@value" : "Esta ontología tiene como propósito definir, categorizar y relacionar las Zonas Regulatorias en el contexto de la movilidad inteligente y la gestión urbana (Smart Cities). Se ha diseñado como una extensión modular de la ontología del Sector Público de España (esadm)."
  }, {
    "@language" : "en",
    "@value" : "This ontology aims to define, categorize, and relate Regulatory Zones in the context of smart mobility and urban management (Smart Cities). It is designed as a modular extension of the Spanish Public Sector ontology (esadm)."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-01-27"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Base Zoning Ontology"
  }, {
    "@language" : "es",
    "@value" : "Ontología base de Zonas"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "edintzone"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "http://vocab.linkeddata.es/datosabiertos/def/common/zone#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Actualmente, existen vocabularios para divisiones administrativas (esadm) y geometrías (GeoSPARQL), pero existía un vacío semántico para representar entidades funcionales que se superponen a la trama urbana (ZBE, Carga y Descarga, etc...) sin responder a límites administrativos fijos. Esta ontología cubre dicho hueco."
  }, {
    "@language" : "en",
    "@value" : "Currently, vocabularies exist for administrative divisions (esadm) and geometries (GeoSPARQL), but there was a semantic gap for representing functional entities that overlay the urban grid (LEZ, Loading/Unloading, etc.) without adhering to fixed administrative boundaries. This ontology fills that gap."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Base Zoning Ontology for Smart Mobility Use Case."
  }, {
    "@language" : "es",
    "@value" : "Ontología base de Zonas para el Caso de Uso de Movilidad Inteligente."
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio_v0.5"
  }, {
    "@id" : "http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/callejero_v0.3"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "0.1.0"
  } ]
}, {
  "@id" : "http://vocab.linkeddata.es/datosabiertos/def/common/zone#RegulatedZone",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Area a la que se aplica una regulacion o normativa particular"
  }, {
    "@language" : "en",
    "@value" : "Area to which a particular regulation or policy applies"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Regulated Zone"
  }, {
    "@language" : "es",
    "@value" : "Zona regulatoria"
  } ],
