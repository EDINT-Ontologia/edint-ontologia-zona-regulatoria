}, {
  "@id" : "https://edint.es/def/zona-regulatoria#RegulatedZone",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Area a la que se aplica una regulacion o normativa particular"
  }, {
    "@language" : "en",
    "@value" : "Area to which a particular regulation or policy applies"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Regulated Zone"
  }, {
    "@language" : "es",
    "@value" : "Zona regulatoria"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Feature"
  }, {
    "@id" : "_:genid18"
  }, {
    "@id" : "_:genid19"
  } ]
}, {
  "@id" : "https://edint.es/def/zona-regulatoria#composedOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relación que permite definir una Zona Regulatoria mediante una o más vías o tramos de vía del vocabulario Callejero."
  }, {
    "@language" : "en",
    "@value" : "Relationship that allows defining a Regulated Zone via one or more streets or street segments from the Callejero vocabulary."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
