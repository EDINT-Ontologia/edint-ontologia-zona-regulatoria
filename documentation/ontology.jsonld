    "@value" : "Inverse property of 'locatedIn'. Links a municipality with the regulated zones it contains."
  }, {
    "@language" : "es",
    "@value" : "Propiedad inversa de 'ubicado'. Vincula un municipio con las zonas regulatorias que contiene."
  } ],
