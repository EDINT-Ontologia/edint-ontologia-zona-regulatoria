    "@language" : "en",
    "@value" : "has regulated zone"
  }, {
    "@language" : "es",
    "@value" : "tiene zona regulatoria"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://vocab.linkeddata.es/datosabiertos/def/common/zone#RegulatedZone"
  } ],
