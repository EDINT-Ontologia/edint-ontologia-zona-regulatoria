  } ]
}, {
  "@id" : "http://vocab.linkeddata.es/datosabiertos/def/common/zone#composedOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relación que permite definir una Zona Regulatoria mediante una o más vías o tramos de vía del vocabulario Callejero."
  }, {
    "@language" : "en",
    "@value" : "Relationship that allows defining a Regulated Zone via one or more streets or street segments from the Callejero vocabulary."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://vocab.linkeddata.es/datosabiertos/def/common/zone#RegulatedZone"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "composed of"
  }, {
    "@language" : "es",
    "@value" : "compuesta por"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
