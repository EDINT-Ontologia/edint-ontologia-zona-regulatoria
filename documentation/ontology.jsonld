      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "http://vocab.linkeddata.es/datosabiertos/def/common/zone#",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/elements/1.1/abstract": [
      {
        "@language": "es",
        "@value": "Esta ontología tiene como propósito definir, categorizar y relacionar las Zonas Regulatorias en el contexto de la movilidad inteligente y la gestión urbana (Smart Cities). Se ha diseñado como una extensión modular de la ontología del Sector Público de España (esadm)."
      },
      {
        "@language": "en",
        "@value": "This ontology aims to define, categorize, and relate Regulatory Zones in the context of smart mobility and urban management (Smart Cities). It is designed as a modular extension of the Spanish Public Sector ontology (esadm)."
      }
    ],
    "http://purl.org/dc/elements/1.1/creator": [
      {
        "@value": "OEG-UPM"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "en",
        "@value": "Base Zoning Ontology"
      },
      {
        "@language": "es",
        "@value": "Ontología base de Zonas"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-01-27"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "edintzone"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "http://vocab.linkeddata.es/datosabiertos/def/common/zone#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "es",
        "@value": "Actualmente, existen vocabularios para divisiones administrativas (esadm) y geometrías (GeoSPARQL), pero existía un vacío semántico para representar entidades funcionales que se superponen a la trama urbana (ZBE, Carga y Descarga, etc...) sin responder a límites administrativos fijos. Esta ontología cubre dicho hueco."
      },
      {
        "@language": "en",
        "@value": "Currently, vocabularies exist for administrative divisions (esadm) and geometries (GeoSPARQL), but there was a semantic gap for representing functional entities that overlay the urban grid (LEZ, Loading/Unloading, etc.) without adhering to fixed administrative boundaries. This ontology fills that gap."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Base Zoning Ontology for Smart Mobility Use Case."
      },
      {
        "@language": "es",
        "@value": "Ontología base de Zonas para el Caso de Uso de Movilidad Inteligente."
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio_v0.5"
      },
      {
        "@id": "http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/callejero_v0.3"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.1.0"
      }
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Urban area or axis characterized by a high density of commercial and service activity, frequently supported by regional commerce regulations under the figure of Open Commercial Zone."
      },
      {
        "@language": "es",
        "@value": "Área o eje urbano caracterizado por una alta densidad de actividad comercial y de servicios, frecuentemente amparada por normativas autonómicas de comercio bajo la figura de Zona Comercial Abierta (ZCA)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Commercial Zone"
      },
      {
        "@language": "es",
        "@value": "Zona Comercial"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {}
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Area delimited by municipal regulations to promote commercial or tourist activities."
      },
      {
        "@language": "es",
        "@value": "Área delimitada por normativas municipales para fomentar actividades comerciales o turísticas."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Economic Interest Zone"
      },
      {
        "@language": "es",
        "@value": "Zona de Interés Económico"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://vocab.linkeddata.es/datosabiertos/def/common/zone#RegulatedZone"
      }
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Area of the Union customs territory where non-Community goods are considered not situated within customs territory."
      },
      {
        "@language": "es",
        "@value": "Área del territorio aduanero de la Unión donde las mercancías no comunitarias se consideran no situadas en territorio aduanero."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Free Trade Zone"
      },
      {
        "@language": "es",
        "@value": "Zona Franca"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {}
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "es",
        "@value": "Espacio libre, parque o área natural urbana sujeta a un régimen de protección urbanística que limita su edificabilidad y regula su uso público, vital para estrategias de mitigación climática y calidad del aire."
      },
      {
        "@language": "en",
        "@value": "Open space, park, or urban natural area subject to a spatial planning protection regime that limits buildability and regulates public use, vital for climate mitigation and air quality strategies."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Green Space Zone"
      },
      {
        "@language": "es",
        "@value": "Zona Verde"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://vocab.linkeddata.es/datosabiertos/def/common/zone#RegulatedZone"
      }
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "es",
        "@value": "Zonas con gran afluencia turística donde se aplica plena libertad de apertura comercial en domingos y festivos."
      },
      {
        "@language": "en",
        "@value": "Zones with high tourist influx where full freedom of commercial opening on Sundays and holidays applies."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "High Tourism Influx Zone"
      },
      {
        "@language": "es",
        "@value": "Zona de Gran Afluencia Turística"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {}
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Urban area with special heritage protection where strict restrictions on access, circulation, and parking apply to preserve the historical fabric."
      },
      {
        "@language": "es",
        "@value": "Área urbana de especial protección patrimonial donde se aplican restricciones estrictas de acceso, circulación y estacionamiento para preservar la trama histórica."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "es",
        "@value": "Casco Histórico"
      },
      {
        "@language": "en",
        "@value": "Historical Center"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://vocab.linkeddata.es/datosabiertos/def/common/zone#RegulatedZone"
      }
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Area delimited by urban planning and Cadastre intended predominantly to host industrial, logistics, and business activities."
      },
      {
        "@language": "es",
        "@value": "Área delimitada por el planeamiento urbanístico (PGOU) y el Catastro destinada predominantemente a albergar actividades industriales, logísticas y empresariales."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Industrial Zone"
      },
      {
        "@language": "es",
        "@value": "Polígono Industrial"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {}
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Area with a high concentration of leisure and hospitality establishments. Frequently subject to specific urban and environmental regulations, such as Special Acoustic Protection Zones."
      },
      {
        "@language": "es",
        "@value": "Área con alta concentración de establecimientos de ocio y hostelería. Frecuentemente sujeta a regulaciones urbanísticas y medioambientales específicas, como las Zonas de Protección Acústica Especial (ZPAE)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Leisure Zone"
      },
      {
        "@language": "es",
        "@value": "Zona de Ocio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://vocab.linkeddata.es/datosabiertos/def/common/zone#RegulatedZone"
      }
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "es",
        "@value": "Zona reservada exclusivamente para la parada técnica de vehículos profesionales dedicados a la Distribución Urbana de Mercancías (DUM)."
      },
      {
        "@language": "en",
        "@value": "Zone reserved exclusively for the technical stop of professional vehicles dedicated to Urban Goods Distribution."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Loading and Unloading Zone"
      },
      {
        "@language": "es",
        "@value": "Zona de Carga y Descarga"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {}
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "es",
        "@value": "Infraestructura especializada en actividades de transporte y logística. Definida legalmente como 'Centro de Transporte y Logística'."
      },
      {
        "@language": "en",
        "@value": "Infrastructure specialized in transport and logistics activities. Legally defined as 'Transport and Logistics Center'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Logistics Activity Zone"
      },
      {
        "@language": "es",
        "@value": "Zona de Actividad Logística"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {}
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "es",
        "@value": "Zona definida por la administración donde se aplican restricciones de acceso, circulación y estacionamiento de vehículos con el objetivo de mejorar la calidad del aire."
      },
      {
        "@language": "en",
        "@value": "Zone defined by the administration where restrictions on vehicle access, circulation, and parking apply to improve air quality."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Low Emission Zone"
      },
      {
        "@language": "es",
        "@value": "Zona de Bajas Emisiones"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://vocab.linkeddata.es/datosabiertos/def/common/zone#RegulatedZone"
      }
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "es",
        "@value": "Zona definida por la administración donde se aplican restricciones de ruido y límites de emisión acústica para proteger la salud pública y el bienestar ciudadano."
      },
      {
        "@language": "en",
        "@value": "Zone defined by the administration where noise restrictions and acoustic emission limits apply to protect public health and citizen well-being."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Low Noise Emission Zone"
      },
      {
        "@language": "es",
        "@value": "Zona de Bajas Emisiones de Ruido"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://vocab.linkeddata.es/datosabiertos/def/common/zone#RegulatedZone"
      }
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Strategic parking zone located on the periphery and connected to public transport networks."
      },
      {
        "@language": "es",
        "@value": "Zona de estacionamiento estratégico situado en la periferia y conectado con redes de transporte público."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Park and Ride Zone"
      },
      {
        "@language": "es",
        "@value": "Zona de Estacionamiento Disuasorio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {}
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Road or area reserved entirely or partially for pedestrian traffic, with strict speed regulations for permitted vehicles and a general prohibition on parking."
      },
      {
        "@language": "es",
        "@value": "Vía o área reservada total o parcialmente para la circulación de peatones, con regulaciones estrictas de velocidad para los vehículos permitidos y prohibición general de estacionamiento."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Pedestrian Zone"
      },
      {
        "@language": "es",
        "@value": "Zona Peatonal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://vocab.linkeddata.es/datosabiertos/def/common/zone#RegulatedZone"
      }
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Parking zone legally reserved for vehicles transporting Persons with Reduced Mobility (PRM), regulated by municipal and national accessibility laws."
      },
      {
        "@language": "es",
        "@value": "Zona de estacionamiento reservada legalmente para vehículos que transportan a Personas con Movilidad Reducida (PMR), regulada por normativas municipales y estatales de accesibilidad."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Reduced Mobility Parking Zone"
      },
      {
        "@language": "es",
        "@value": "Zona de Estacionamiento PMR"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {}
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Public road zone where parking is subject to time regulation, fee payment, or other restrictions."
      },
      {
        "@language": "es",
        "@value": "Zona de la vía pública donde el estacionamiento está sujeto a regulación horaria, pago de tasas u otras restricciones."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Regulated Parking Zone"
      },
      {
        "@language": "es",
        "@value": "Zona de Estacionamiento Regulado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://vocab.linkeddata.es/datosabiertos/def/common/zone#RegulatedZone"
      }
    ]
  },
  {
    "@id": "http://vocab.linkeddata.es/datosabiertos/def/common/zone#RegulatedZone",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "es",
        "@value": "Area a la que se aplica una regulacion o normativa particular"
      },
      {
        "@language": "en",
        "@value": "Area to which a particular regulation or policy applies"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Regulated Zone"
      },
      {
        "@language": "es",
        "@value": "Zona regulatoria"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.opengis.net/ont/geosparql#Feature"
      },
      {
        "@id": "_:genid1"
      },
      {
        "@id": "_:genid2"
      }
    ]
  },
  {
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Controlled testing environment authorized for research trials with automated vehicles or new forms of mobility."
      },
      {
        "@language": "es",
        "@value": "Espacio controlado de pruebas autorizado para la realización de ensayos de investigación con vehículos automatizados o nuevas formas de movilidad."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Regulatory Sandbox"
      },
      {
        "@language": "es",
