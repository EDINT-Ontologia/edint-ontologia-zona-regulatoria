    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->


    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
        <rdfs:label xml:lang="en">has geometry</rdfs:label>
        <rdfs:label xml:lang="es">tiene geometría</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#sfWithin -->


    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfWithin"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme"/>
    


    <!-- https://edint.es/def/zona-regulatoria#composedOf -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/zona-regulatoria#composedOf">
        <rdfs:domain rdf:resource="https://edint.es/def/zona-regulatoria#RegulatedZone"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/callejero#TramoVia"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/callejero#Via"/>
        <rdfs:range rdf:resource="http://www.geonames.org/ontology#Feature"/>
        <rdfs:comment xml:lang="es">Relación que permite definir una Zona Regulatoria mediante una o más vías o tramos de vía del vocabulario Callejero.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship that allows defining a Regulated Zone via one or more streets or street segments from the Callejero vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="en">composed of</rdfs:label>
        <rdfs:label xml:lang="es">compuesta por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/zona-regulatoria#hasRegulatedZone -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/zona-regulatoria#hasRegulatedZone">
        <owl:inverseOf rdf:resource="https://edint.es/def/zona-regulatoria#locatedIn"/>
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio"/>
        <rdfs:range rdf:resource="https://edint.es/def/zona-regulatoria#RegulatedZone"/>
        <rdfs:comment xml:lang="en">Inverse property of &apos;locatedIn&apos;. Links a municipality with the regulated zones it contains.</rdfs:comment>
        <rdfs:comment xml:lang="es">Propiedad inversa de &apos;ubicado&apos;. Vincula un municipio con las zonas regulatorias que contiene.</rdfs:comment>
        <rdfs:label xml:lang="en">has regulated zone</rdfs:label>
        <rdfs:label xml:lang="es">tiene zona regulatoria</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/zona-regulatoria#hasRegulatedZoneType -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/zona-regulatoria#hasRegulatedZoneType">
        <rdfs:domain rdf:resource="https://edint.es/def/zona-regulatoria#RegulatedZone"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/RegulatedZoneType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Links a regulated zone to its type classification from the RegulatedZoneType SKOS concept scheme.</rdfs:comment>
        <rdfs:comment xml:lang="es">Vincula una zona regulada a su clasificación de tipo del esquema de conceptos SKOS RegulatedZoneType.</rdfs:comment>
        <rdfs:label xml:lang="en">has regulated zone type</rdfs:label>
        <rdfs:label xml:lang="es">tiene tipo de zona regulada</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/zona-regulatoria#locatedIn -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/zona-regulatoria#locatedIn">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
        <rdfs:domain rdf:resource="https://edint.es/def/zona-regulatoria#RegulatedZone"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio"/>
        <rdfs:comment xml:lang="es">Relaciona una zona regulatoria con el municipio administrativo al que pertenece.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a regulated zone to the administrative municipality it belongs to.</rdfs:comment>
        <rdfs:label xml:lang="en">located in municipality</rdfs:label>
        <rdfs:label xml:lang="es">ubicado en municipio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/zona-regulatoria#managedBy -->


    <owl:ObjectProperty rdf:about="https://edint.es/def/zona-regulatoria#managedBy">
        <rdfs:domain rdf:resource="https://edint.es/def/zona-regulatoria#RegulatedZone"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <rdfs:comment xml:lang="es">Organización (pública o privada) encargada de la gestión y operación de la zona.</rdfs:comment>
        <rdfs:comment xml:lang="en">Organization (public or private) responsible for the management and operation of the zone.</rdfs:comment>
        <rdfs:label xml:lang="es">entidad gestora</rdfs:label>
        <rdfs:label xml:lang="en">managed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.opengis.net/ont/geosparql#asWKT -->


    <owl:DatatypeProperty rdf:about="http://www.opengis.net/ont/geosparql#asWKT">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/sf#Geometry"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#wktLiteral"/>
        <rdfs:comment xml:lang="en">Geometry representation in Well-Known Text format.</rdfs:comment>
        <rdfs:comment xml:lang="es">Representación de la geometría en formato Well-Known Text.</rdfs:comment>
        <rdfs:label xml:lang="en">as WKT</rdfs:label>
        <rdfs:label xml:lang="es">como WKT</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/zona-regulatoria#endDate -->


    <owl:DatatypeProperty rdf:about="https://edint.es/def/zona-regulatoria#endDate">
        <rdfs:domain rdf:resource="https://edint.es/def/zona-regulatoria#RegulatedZone"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date when the zone regulation ceases to be effective.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fecha en la que la regulación de la zona deja de ser efectiva (derogación o fin de periodo).</rdfs:comment>
        <rdfs:label xml:lang="en">end date</rdfs:label>
        <rdfs:label xml:lang="es">fecha de fin de vigor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/zona-regulatoria#legalReference -->


    <owl:DatatypeProperty rdf:about="https://edint.es/def/zona-regulatoria#legalReference">
        <rdfs:domain rdf:resource="https://edint.es/def/zona-regulatoria#RegulatedZone"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="es">Enlace al documento oficial (Boletín, Ordenanza) que establece la creación de la zona.</rdfs:comment>
        <rdfs:comment xml:lang="en">Link to the official document (Bulletin, Ordinance) establishing the zone.</rdfs:comment>
        <rdfs:label xml:lang="en">legal reference</rdfs:label>
        <rdfs:label xml:lang="es">referencia legal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/zona-regulatoria#scheduleDescription -->


    <owl:DatatypeProperty rdf:about="https://edint.es/def/zona-regulatoria#scheduleDescription">
        <rdfs:domain rdf:resource="https://edint.es/def/zona-regulatoria#RegulatedZone"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Descripción textual del horario de funcionamiento de la zona (ej. &quot;Lunes a Viernes de 07:00 a 20:00&quot;).</rdfs:comment>
        <rdfs:comment xml:lang="en">Textual description of the zone&apos;s operating schedule (e.g., &quot;Monday to Friday from 07:00 to 20:00&quot;).</rdfs:comment>
        <rdfs:label xml:lang="es">horario descriptivo</rdfs:label>
        <rdfs:label xml:lang="en">schedule description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/zona-regulatoria#startDate -->


    <owl:DatatypeProperty rdf:about="https://edint.es/def/zona-regulatoria#startDate">
        <rdfs:domain rdf:resource="https://edint.es/def/zona-regulatoria#RegulatedZone"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date from which the zone regulation becomes effective.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fecha a partir de la cual la regulación de la zona comienza a ser efectiva.</rdfs:comment>
        <rdfs:label xml:lang="en">entry into force date</rdfs:label>
        <rdfs:label xml:lang="es">fecha de entrada en vigor</rdfs:label>
    </owl:DatatypeProperty>
    


