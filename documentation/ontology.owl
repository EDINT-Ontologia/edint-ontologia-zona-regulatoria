    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Feature"/>
    


    <!-- http://www.opengis.net/ont/sf#Geometry -->


    <owl:Class rdf:about="http://www.opengis.net/ont/sf#Geometry"/>
    


