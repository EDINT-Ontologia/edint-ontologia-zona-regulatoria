        <owl:imports rdf:resource="http://www.opengis.net/ont/geosparql"/>
        <dcterms:description xml:lang="es">Esta ontología tiene como propósito definir, categorizar y relacionar las Zonas Regulatorias en el contexto de la movilidad inteligente y la gestión urbana (Smart Cities). Se ha diseñado como una extensión modular de la ontología del Sector Público de España (esadm).</dcterms:description>
        <dcterms:description xml:lang="en">This ontology aims to define, categorize, and relate Regulatory Zones in the context of smart mobility and urban management (Smart Cities). It is designed as a modular extension of the Spanish Public Sector ontology (esadm).</dcterms:description>
        <dcterms:creator rdf:parseType="Resource">
            <foaf:name>Daniel Doña</foaf:name>
            <schema:affiliation rdf:resource="https://oeg.fi.upm.es/"/>
        </dcterms:creator>
        <dcterms:creator rdf:parseType="Resource">
            <foaf:name>Edna Ruckhaus</foaf:name>
            <schema:affiliation rdf:resource="https://oeg.fi.upm.es/"/>
        </dcterms:creator>
        <dcterms:creator rdf:parseType="Resource">
            <foaf:name>Lucía Sánchez</foaf:name>
            <schema:affiliation rdf:resource="https://oeg.fi.upm.es/"/>
        </dcterms:creator>
        <dcterms:creator rdf:parseType="Resource">
            <foaf:name>Oscar Corcho</foaf:name>
            <schema:affiliation rdf:resource="https://oeg.fi.upm.es/"/>
        </dcterms:creator>
        <dcterms:title xml:lang="en">EDINT Regulated Zone Ontology</dcterms:title>
        <rdfs:label xml:lang="es">Zonas Regulatorias</rdfs:label>
        <rdfs:label xml:lang="en">Regulated Zones</rdfs:label>
        <dcterms:title xml:lang="es">Ontología EDINT de Zonas Regulatorias</dcterms:title>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <vann:preferredNamespacePrefix>edintzone</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://edint.es/def/zona-regulatoria#"/>
        <rdfs:comment xml:lang="es">Actualmente, existen vocabularios para divisiones administrativas (esadm) y geometrías (GeoSPARQL), pero existía un vacío semántico para representar entidades funcionales que se superponen a la trama urbana (ZBE, Carga y Descarga, etc...) sin responder a límites administrativos fijos. Esta ontología cubre dicho hueco.</rdfs:comment>
        <rdfs:comment xml:lang="en">Currently, vocabularies exist for administrative divisions (esadm) and geometries (GeoSPARQL), but there was a semantic gap for representing functional entities that overlay the urban grid (LEZ, Loading/Unloading, etc.) without adhering to fixed administrative boundaries. This ontology fills that gap.</rdfs:comment>
        <owl:versionInfo>0.2.1</owl:versionInfo>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-01-27</dcterms:created>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-17</dcterms:issued>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-17</dcterms:modified>
        <owl:priorVersion rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-zona-regulatoria/releases/tag/v0.2.0"/>
        <schema:codeRepository rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-zona-regulatoria"/>
        <schema:funding>Espacio de Datos para las Infraestructuras Urbanas Inteligentes (EDINT)</schema:funding>
        <dcterms:publisher rdf:parseType="Resource">
            <foaf:name>FEMP</foaf:name>
            <foaf:homepage rdf:resource="https://www.femp.es/"/>
            <schema:affiliation>Federación Española de Municipios y Provincias</schema:affiliation>
        </dcterms:publisher>
    <dcterms:bibliographicCitation xml:lang="es">Ontología EDINT de Zonas Regulatorias. EDINT. Revisión: v0.2.1.</dcterms:bibliographicCitation>
    <dcterms:bibliographicCitation xml:lang="en">EDINT Regulated Zone Ontology. EDINT. Revision: v0.2.1.</dcterms:bibliographicCitation>
    <schema:creativeWorkStatus xml:lang="en">Ontology Specification</schema:creativeWorkStatus>
    <dcterms:abstract xml:lang="es">Esta ontología tiene como propósito definir, categorizar y relacionar las Zonas Regulatorias en el contexto de la movilidad inteligente y la gestión urbana (Smart Cities). Se ha diseñado como una extensión modular de la ontología del Sector Público de España (esadm). Cubre el vacío semántico para representar entidades funcionales que se superponen a la trama urbana (como Zonas de Bajas Emisiones, Carga y Descarga, o Sandboxes regulatorios) sin responder necesariamente a límites administrativos fijos.</dcterms:abstract>
    <dcterms:abstract xml:lang="en">This ontology aims to define, categorize, and relate Regulatory Zones in the context of smart mobility and urban management (Smart Cities). It is designed as a modular extension of the Spanish Public Sector ontology (esadm).</dcterms:abstract>
</owl:Ontology>
    <foaf:Organization rdf:about="https://oeg.fi.upm.es/">
        <foaf:name>Ontology Engineering Group, UPM</foaf:name>
    </foaf:Organization>
    


