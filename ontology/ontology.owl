     xmlns:widoco="https://w3id.org/widoco/vocab#">    <owl:Ontology rdf:about="https://edint.es/def/zona-regulatoria#">
        <owl:versionIRI rdf:resource="https://edint.es/def/zona-regulatoria/0.2.1"/>
        <owl:imports rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio"/>
